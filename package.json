{
  "name": "omniget",
  "version": "0.10.1",
  "description": "Free desktop downloader for YouTube, Instagram, TikTok, X, Reddit, torrents and the sites yt-dlp supports, with an MCP server for Claude Code, Cursor and VS Code, and a window for AI agents (Claude Code, Codex, Gemini CLI, Ollama). Open source for Windows, macOS and Linux.",
  "keywords": [
    "downloader",
    "yt-dlp",
    "yt-dlp-gui",
    "youtube-downloader",
    "video-downloader",
    "instagram-downloader",
    "tiktok-downloader",
    "torrent",
    "mcp",
    "ai-agents",
    "claude-code",
    "codex",
    "gemini-cli",
    "ollama",
    "mcp-server",
    "agent-client-protocol",
    "coding-agent",
    "desktop-app",
    "tauri"
  ],
  "homepage": "https://getomniget.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tonhowtf/omniget.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "tauri:appimage": "bash scripts/linux/appimage.sh",
    "version:set": "node scripts/bump-version.js",
    "generate:i18n-keys": "node scripts/generate-i18n-keys.js",
    "check:i18n": "node scripts/generate-i18n-keys.js --strict",
    "check:clippy-baseline": "node scripts/clippy-baseline.mjs --check",
    "update:clippy-baseline": "node scripts/clippy-baseline.mjs --update",
    "extension:sync": "node browser-extension/sync.mjs",
    "test": "vitest run",
    "test:fast": "node scripts/test-fast.mjs",
    "test:watch": "vitest"
  },
  "license": "GPL-3.0",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-updater": "^2.10.0",
    "bot-avatars": "^0.1.1",
    "marked": "^14.1.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sveltekit-i18n": "^2.4.2",
    "thinking-orbs": "^0.3.2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^25.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright": "^1.62.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.4"
  }
}
